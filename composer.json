{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "birdcar/authkit-laravel",
    "description": "A \"batteries included\" implementation of AuthKit and the entire WorkOS Suite for Laravel",
    "keywords": [
        "laravel",
        "birdcar",
        "authkit-laravel"
    ],
    "homepage": "https://github.com/birdcar/authkit-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Birdcar",
            "email": "devrel@birdcar.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.0||^8.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "laravel/framework": "^12.0||^13.0",
        "laravel/pennant": "^1.22",
        "workos/workos-php": "^9.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/mcp": "^0.9.1",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Authkit\\Authkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Authkit\\Authkit\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Authkit\\Authkit\\AuthkitServiceProvider"
            ],
            "aliases": {
                "Authkit": "Authkit\\Authkit\\Facades\\Authkit",
                "Vault": "Authkit\\Authkit\\Facades\\Vault"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
