includes:
    - ./vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - src/Models/Concerns
        - src/Audit/Concerns
        - src/Testing/Concerns
        - src/Listeners/Concerns
        - src/Livewire/Concerns
        - src/Livewire/Widgets
    tmpDir: .phpstan-cache
